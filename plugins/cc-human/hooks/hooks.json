{
  "description": "Human persona writing rules enforcement. Injects a rules summary at session start, hard-blocks violations on Write/Edit/MultiEdit before they land, and scans the written file as a backstop.",
  "hooks": {
    "SessionStart": [
      {
 "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-inject.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scan.cjs\" pre",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scan.cjs\" post",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
